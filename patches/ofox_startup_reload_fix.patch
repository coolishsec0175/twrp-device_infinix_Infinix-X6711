+// Validate the saved OrangeFox theme/navbar files before a theme reload.
+// Returns true if there is nothing to validate, or if every saved file is
+// readable, version-correct and well-formed XML. If the saved theme was written
+// by an older/different OFOX build (version mismatch) or is otherwise
+// invalid/missing, the stale theme and navbar directories are removed so that
+// a theme reload (reapply_settings page) cannot stall the GUI, and false is
+// returned.
+//
+// Note: rapidxml's parse_error_handler is replaced by a non-throwing handler
+// (gui/gui.cpp), so parse errors surface as an empty/incomplete document, which
+// is detected below via the root element check.
+bool gui_validate_theme_files()
+{
+	std::string settings_path = DataManager::GetSettingsStoragePath();
+	if (settings_path.empty())
+		settings_path = "/sdcard";
+	std::string fox_dir = settings_path + "/Fox";
+
+	// Version check - the saved theme version is stored in the on-disk settings
+	// file. Read it directly from the file (not from DataManager, whose in-memory
+	// value may already have been bumped) and compare it against the current
+	// build's theme version. A mismatch means the saved theme files were written
+	// by an older/different OFOX build, so they MUST be discarded before they can
+	// be applied - applying them can stall the GUI. Using the resolved settings
+	// storage path also works early in boot, before the /sdcard symlink exists.
+	std::string saved_ver;
+	if (TWFunc::Path_Exists(fox_dir + "/.foxs")) {
+		InfoManager fox_settings(fox_dir + "/.foxs");
+		fox_settings.LoadValues();
+		fox_settings.GetValue("of_themes_version", saved_ver);
+	}
+	std::string build_ver = DataManager::GetStrValue("fox_theme_version");
+	if (build_ver.empty())
+		build_ver = "0";
+
+	bool version_mismatch = false;
+	if (saved_ver.empty()) {
+		// no saved version - if a theme still exists it was never stamped with
+		// the current theme version, so treat it as stale
+		if (TWFunc::Path_Exists(fox_dir + "/.theme") || TWFunc::Path_Exists(fox_dir + "/.navbar"))
+			version_mismatch = true;
+	} else if (saved_ver != build_ver) {
+		version_mismatch = true;
+	}
+
+	if (version_mismatch) {
+		LOGERR("OrangeFox: theme version mismatch (old='%s'; new='%s'); discarding stale theme/navbar - the stock theme will be used.\n",
+			saved_ver.c_str(), build_ver.c_str());
+		TWFunc::removeDir(fox_dir + "/.theme", false);
+		TWFunc::removeDir(fox_dir + "/.navbar", false);
+		TWFunc::removeDir(FOX_THEME_PATH, false);
+		TWFunc::removeDir(FOX_NAVBAR_PATH, false);
+		// stamp the current version so the reset only happens once
+		DataManager::SetValue("of_themes_version", build_ver);
+		DataManager::Flush();
+		return false;
+	}
+
+	// XML validation of the saved theme/navbar files (resolved paths)
+	if (!TWFunc::Path_Exists(fox_dir + "/.theme") && !TWFunc::Path_Exists(fox_dir + "/.navbar"))
+		return true;
+
+	const std::string theme_files[] = {
+		fox_dir + "/.theme/font.xml",
+		fox_dir + "/.theme/style.xml",
+		fox_dir + "/.theme/accent.xml",
+		fox_dir + "/.theme/action.xml",
+		fox_dir + "/.navbar/navbar.xml"
+	};
+
+	bool valid = true;
+	for (const std::string& file : theme_files) {
+		// missing files are fine - the theme provides a default fallback for them
+		if (!TWFunc::Path_Exists(file))
+			continue;
+
+		char* buffer = PageManager::LoadFileToBuffer(file, NULL);
+		if (!buffer) {
+			LOGERR("OrangeFox: theme file '%s' is not readable.\n", file.c_str());
+			valid = false;
+			break;
+		}
+		{
+			xml_document<> doc;
+			doc.parse<0>(buffer);
+			free(buffer);
+			xml_node<>* root = doc.first_node("recovery");
+			if (!root)
+				root = doc.first_node("install");
+			if (!root) {
+				LOGERR("OrangeFox: theme file '%s' has an invalid root element.\n", file.c_str());
+				valid = false;
+				break;
+			}
+		}
+	}
+
+	if (!valid) {
+		LOGERR("OrangeFox: discarding stale theme/navbar - the stock theme will be used.\n");
+		TWFunc::removeDir(fox_dir + "/.theme", false);
+		TWFunc::removeDir(fox_dir + "/.navbar", false);
+		TWFunc::removeDir(FOX_THEME_PATH, false);
+		TWFunc::removeDir(FOX_NAVBAR_PATH, false);
+	}
+	return valid;
+}
