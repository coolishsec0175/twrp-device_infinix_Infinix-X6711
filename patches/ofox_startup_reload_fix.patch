+// Validate the saved OrangeFox theme/navbar files before a theme reload.
+// Returns true if there is nothing to validate, or if every saved file is
+// readable and well-formed XML. If any file is missing/invalid (e.g. it was
+// written by an older or different OFOX build), the stale theme and navbar
+// directories are removed so that the theme reload (reapply_settings page)
+// cannot stall the GUI, and false is returned.
+//
+// Note: rapidxml's parse_error_handler is replaced by a non-throwing handler
+// (gui/gui.cpp), so parse errors surface as an empty/incomplete document, which
+// is detected below via the root element check.
+bool gui_validate_theme_files()
+{
+	if (!TWFunc::Path_Exists(FOX_THEME_PATH) && !TWFunc::Path_Exists(FOX_NAVBAR_PATH))
+		return true;
+
+	std::string theme_path = FOX_THEME_PATH;
+	std::string navbar_path = FOX_NAVBAR_PATH;
+	const std::string theme_files[] = {
+		theme_path + "/font.xml",
+		theme_path + "/style.xml",
+		theme_path + "/accent.xml",
+		theme_path + "/action.xml",
+		navbar_path + "/navbar.xml"
+	};
+
+	bool valid = true;
+	for (const std::string& file : theme_files) {
+		// missing files are fine - the theme provides a default fallback for them
+		if (!TWFunc::Path_Exists(file))
+			continue;
+
+		char* buffer = PageManager::LoadFileToBuffer(file, NULL);
+		if (!buffer) {
+			LOGERR("OrangeFox: theme file '%s' is not readable.\n", file.c_str());
+			valid = false;
+			break;
+		}
+		{
+			xml_document<> doc;
+			doc.parse<0>(buffer);
+			free(buffer);
+			xml_node<>* root = doc.first_node("recovery");
+			if (!root)
+				root = doc.first_node("install");
+			if (!root) {
+				LOGERR("OrangeFox: theme file '%s' has an invalid root element.\n", file.c_str());
+				valid = false;
+				break;
+			}
+		}
+	}
+
+	if (!valid) {
+		LOGERR("OrangeFox: discarding stale theme/navbar - the stock theme will be used.\n");
+		TWFunc::removeDir(FOX_THEME_PATH, false);
+		TWFunc::removeDir(FOX_NAVBAR_PATH, false);
+	}
+	return valid;
+}
