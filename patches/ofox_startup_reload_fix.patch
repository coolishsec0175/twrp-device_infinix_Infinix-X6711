 using namespace std;
 
+// Find a usable CPU temperature file. On MediaTek devices the thermal zone
+// number assigned to the CPU is NOT stable across boots (zones are enumerated
+// in an arbitrary order), so probe each zone's "type" attribute and pick the
+// one that matches the CPU (mtktscpu / cpu-thermal / cpu_thermal). Falls back
+// to TW_CUSTOM_CPU_TEMP_PATH (if it exists), then thermal_zone0.
+static std::string Find_CPU_Temp_File()
+{
+#ifdef TW_CUSTOM_CPU_TEMP_PATH
+	std::string custom = EXPAND(TW_CUSTOM_CPU_TEMP_PATH);
+	if (TWFunc::Path_Exists(custom))
+		return custom;
+#endif
+	for (int i = 0; i < 40; i++) {
+		std::string zone = "/sys/class/thermal/thermal_zone" + std::to_string(i);
+		std::string type_file = zone + "/type";
+		if (TWFunc::Path_Exists(type_file)) {
+			std::string type;
+			if (TWFunc::read_file(type_file, type) == 0 &&
+			    (type.find("cpu") != std::string::npos ||
+			     type.find("mtkts") != std::string::npos))
+				return zone + "/temp";
+		}
+	}
+	return "/sys/class/thermal/thermal_zone0/temp";
+}
